{
  "name": "japanese-orthography",
  "version": "0.0.0",
  "description": "Reusable Japanese orthography transformation core for historical kana, kyujitai, ruby parsing, and contextual restoration",
  "scripts": {
    "validate": "node --import tsx tools/validate.ts",
    "validate:profile": "node --import tsx tools/validate-profile.ts",
    "validate:intake": "node --import tsx tools/validate-intake.ts",
    "compile": "node --import tsx tools/compile.ts",
    "compile:profile": "node --import tsx tools/compile-profile.ts",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "bench:resolver": "node --import tsx tools/bench-orthography-resolution.ts --json",
    "check:profile": "node --import tsx tools/check-profile.ts",
    "check": "npm run validate && npm run validate:profile && npm run validate:intake && npm run validate:native-kana && npm run validate:sino-kana && npm run validate:kinotch-profile-intake && npm run validate:jmdict-intake && npm run validate:lexical-join && npm run validate:orthography-accounting && npm run validate:orthography-v2-bundle && npm run validate:browser-pack && npm test && npm run typecheck && node --import tsx tools/check.ts && npm run check:profile",
    "generate:native-kana": "node --import tsx tools/generate-native-kana.ts",
    "validate:native-kana": "node --import tsx tools/validate-native-kana.ts",
    "generate:sino-kana": "node --import tsx tools/sino-kana.ts",
    "validate:sino-kana": "node --import tsx tools/validate-sino-kana.ts",
    "generate:kinotch-profile-intake": "node --import tsx tools/kinotch-profile-intake.ts",
    "validate:kinotch-profile-intake": "node --import tsx tools/validate-kinotch-profile-intake.ts",
    "generate:jmdict-intake": "node --import tsx tools/generate-jmdict-intake.ts",
    "validate:jmdict-intake": "node --import tsx tools/validate-jmdict-intake.ts",
    "measure:lexical-graph": "node --import tsx tools/measure-lexical-graph.ts",
    "generate:lexical-join": "node --import tsx tools/generate-lexical-join.ts",
    "validate:lexical-join": "node --import tsx tools/generate-lexical-join.ts --check",
    "measure:compact-runtime": "node --expose-gc --import tsx tools/measure-compact-runtime.ts",
    "generate:orthography-accounting": "node --import tsx tools/orthography-migration-accounting.ts",
    "measure:orthography-v2": "node --expose-gc --import tsx tools/measure-orthography-v2.ts",
    "measure:browser-pack": "node --expose-gc --import tsx tools/measure-browser-pack.ts",
    "generate:orthography-v2-bundle": "node --import tsx tools/orthography-v2-bundle.ts",
    "validate:orthography-v2-bundle": "node --import tsx tools/orthography-v2-bundle.ts --check",
    "validate:orthography-accounting": "node --import tsx tools/orthography-migration-accounting.ts --check",
    "generate:browser-pack": "node --import tsx tools/generate-browser-pack.ts",
    "validate:browser-pack": "node --import tsx tools/generate-browser-pack.ts --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinoko34077/japanese-orthography.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true
}
