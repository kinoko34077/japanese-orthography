{
  "name": "japanese-orthography",
  "version": "0.0.0",
  "description": "Reusable Japanese orthography transformation core for historical kana, kyujitai, ruby parsing, and contextual restoration",
  "scripts": {
    "validate": "node --import tsx tools/validate.ts",
    "validate:profile": "node --import tsx tools/validate-profile.ts",
    "validate:intake": "node --import tsx tools/validate-intake.ts",
    "compile": "node --import tsx tools/compile.ts",
    "compile:profile": "node --import tsx tools/compile-profile.ts",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit",
    "bench:resolver": "node --import tsx tools/bench-orthography-resolution.ts --json",
    "check:profile": "node --import tsx tools/check-profile.ts",
    "check": "npm run validate && npm run validate:profile && npm run validate:intake && npm run validate:native-kana && npm test && npm run typecheck && node --import tsx tools/check.ts && npm run check:profile",
    "validate:native-kana": "node --import tsx tools/validate-native-kana.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinoko34077/japanese-orthography.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true
}
