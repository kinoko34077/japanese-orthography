{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinotch-token-style-overlay-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "authority",
    "responsibility",
    "packId",
    "kind",
    "genericSafety",
    "sourceSnapshot",
    "rules"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profileId": { "type": "string", "minLength": 1 },
    "authority": { "const": "project_profile" },
    "responsibility": { "const": "style_render" },
    "packId": { "const": "token-style" },
    "kind": { "const": "token-rules" },
    "genericSafety": { "const": "not_implied" },
    "sourceSnapshot": { "$ref": "#/$defs/sourceSnapshot" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tokenRule" }
    }
  },
  "$defs": {
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path", "blobSha"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 1 },
        "blobSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "tokenRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "match", "priority"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "match": { "const": "exact_token" },
        "priority": { "type": "integer" }
      }
    }
  }
}
