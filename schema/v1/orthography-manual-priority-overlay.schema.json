{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orthography-manual-priority-overlay-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "entries"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "kind": { "const": "orthography_manual_priority_overlay" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringSet": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "minItems": 2,
      "uniqueItems": true
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "channel",
        "sourceCandidates",
        "preferred",
        "rationale",
        "evidenceRefs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "key": { "$ref": "#/$defs/nonEmptyString" },
        "channel": {
          "enum": ["surface", "reading", "character_form"]
        },
        "sourceCandidates": { "$ref": "#/$defs/stringSet" },
        "preferred": { "$ref": "#/$defs/nonEmptyString" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      }
    }
  }
}
