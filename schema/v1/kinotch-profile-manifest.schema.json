{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kinotch-profile-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "authority", "sourceSnapshots", "packs"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profileId": { "type": "string", "minLength": 1 },
    "authority": { "const": "compatibility_profile" },
    "sourceSnapshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceSnapshot" }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packRef" }
    }
  },
  "$defs": {
    "sourcePack": { "enum": ["legacy", "official-homophone", "project-homophone"] },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path", "blobSha", "role"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 1 },
        "blobSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "role": { "$ref": "#/$defs/sourcePack" }
      }
    },
    "packRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "sourcePack", "genericSafety"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "pattern": "^[^/]+\\.json$" },
        "sourcePack": { "$ref": "#/$defs/sourcePack" },
        "genericSafety": { "const": "not_implied" }
      }
    }
  }
}
